# Leave blank to use the dev proxy. Set to the backend URL in production.
# NOTE: this project does NOT use the VITE_ prefix (it broke deploys). The
# value is injected into the browser bundle by vite.config.js `define`.
API_BASE_URL=

# Backend the dev server proxies /api and /auth to (local Express by default).
PROXY_TARGET=http://localhost:5000
